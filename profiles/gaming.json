{
  "id": "gaming-builtin",
  "name": "Gaming",
  "category": "Gaming",
  "description": "Spatial awareness profile. Elevates directional footstep cues and reload sounds while reigning in harsh explosions.",
  "icon": "🎮",
  "target_device": "PRO X SE Gaming Headset",
  "preamp_db": -2.40,
  "filters": [
    {
      "type": "HP",
      "freq": 35.0,
      "gain": 0.0,
      "q": 0.707,
      "enabled": true,
      "comment": "Subsonic cut to declutter low end"
    },
    {
      "type": "PK",
      "freq": 120.0,
      "gain": -1.5,
      "q": 1.2,
      "enabled": true,
      "comment": "De-boom bass for faster acoustic recovery"
    },
    {
      "type": "PK",
      "freq": 2200.0,
      "gain": 2.2,
      "q": 1.6,
      "enabled": true,
      "comment": "Footstep texture and equipment movement cues"
    },
    {
      "type": "PK",
      "freq": 6000.0,
      "gain": -2.5,
      "q": 2.5,
      "enabled": true,
      "comment": "Tame piercing gunshot transients"
    },
    {
      "type": "PK",
      "freq": 8000.0,
      "gain": 1.8,
      "q": 1.8,
      "enabled": true,
      "comment": "Positional imaging and spatial localization cues"
    }
  ],
  "spatial": {
    "crossfeed_enabled": false,
    "crossfeed_cutoff_hz": 700.0,
    "crossfeed_feed_db": -6.0,
    "hf_smoothing_enabled": false,
    "hf_smoothing_cutoff": 8500.0
  },
  "is_experimental": false,
  "is_builtin": true,
  "notes": "Competitive spatial profile tailored for Dolby Atmos positional staging."
}
